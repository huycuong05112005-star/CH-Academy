# ===========================
# CH Academy - .gitignore
# ===========================

# ----- Environment & Secrets -----
.env
.env.local
.env.*.local
*.secret
secrets/

# ----- IDE -----
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.classpath
.settings/

# ----- OS -----
.DS_Store
Thumbs.db
desktop.ini

# ----- Java / Maven -----
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# ----- Node / Frontend -----
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.cache/
frontend/coverage/
*.tsbuildinfo

# ----- Logs -----
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ----- Docker & Uploads -----
docker-volumes/
uploads/
backend/uploads/
database/backups/
