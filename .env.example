# ===========================
# CH Academy - Cấu hình mẫu
# Sao chép thành .env và điền giá trị thật
# KHÔNG commit file .env vào git
# ===========================

# ----- PostgreSQL -----
POSTGRES_DB=ch_academy
POSTGRES_USER=ch_academy_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432

# ----- Backend -----
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ----- Frontend -----
VITE_API_BASE_URL=http://localhost:8080/api/v1
FRONTEND_PORT=5173

# ----- JWT (sẽ dùng khi triển khai xác thực) -----
# JWT_SECRET=your_jwt_secret_here
# JWT_EXPIRATION_MS=86400000
